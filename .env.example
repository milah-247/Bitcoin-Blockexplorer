# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# mainnet | testnet | signet | regtest
NETWORK=mainnet

# --- RPC endpoint -----------------------------------------------------------
# Hosted provider (bitrpc.thebuidl.xyz): JSON-RPC lives under /bitcoin and is
# authenticated with an API key sent in the X-API-Key header.
RPC_URL=https://bitrpc.thebuidl.xyz/bitcoin
RPC_API_KEY=your-api-key-here
# RPC_API_KEY_HEADER=X-API-Key

# Local Bitcoin Core instead: unset RPC_API_KEY and use one of
# RPC_URL=http://127.0.0.1:8332
# RPC_USER=user
# RPC_PASS=pass
# RPC_COOKIE=/home/you/.bitcoin/.cookie

# --- Provider etiquette -----------------------------------------------------
# The provider allows ~100 requests/minute per key; stay below it.
RPC_RATE_LIMIT_PER_MIN=90
RPC_MAX_CONCURRENCY=4
RPC_TIMEOUT_SECS=30
RPC_MAX_RETRIES=3

# --- HTTP server ------------------------------------------------------------
BIND=127.0.0.1:3000
# RUST_LOG=info
# Whole-request time limit (all RPC calls of one API request)
REQUEST_TIMEOUT_SECS=120
# Comma-separated allowed origins, or * for any. Unset = no CORS headers
# (not needed when the frontend is served by this server).
# CORS_ORIGINS=http://localhost:5173

# --- Cache ------------------------------------------------------------------
CACHE_MAX_MB=256
# Block content, and blocks/txs buried 6+ deep
CACHE_TTL_LONG_SECS=86400
# Recent blocks, mempool txs
CACHE_TTL_SHORT_SECS=15
CACHE_TTL_TIP_SECS=5

# --- Address index (SQLite) -------------------------------------------------
# The provider forbids scantxoutset and has no address index, so we build one.
INDEX_ENABLED=true
INDEX_DB_PATH=data/index-bitcoin.sqlite
# A height (e.g. 860000) or tip-N, fixed at first start. ~1.8 MB and ~5 s per
# mainnet block: tip-144 (1 day) ≈ 260 MB / ~11 min, tip-1008 (1 week) ≈ 1.8 GB / ~80 min.
# Changing it later requires deleting the index file.
START_HEIGHT=tip-144
INDEX_CONCURRENCY=2
INDEX_POLL_SECS=15
INDEX_MAX_REORG=100
